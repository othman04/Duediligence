# ══════════════════════════════════════════════════════════
# Backend — variables d'environnement (à copier vers .env)
#   cp Backend/.env.example Backend/.env
# ══════════════════════════════════════════════════════════

# Connexion MongoDB Atlas (cluster du projet)
MONGO_URL=mongodb+srv://<UTILISATEUR>:<MOT_DE_PASSE>@<CLUSTER>.mongodb.net/<NOM_BASE>?retryWrites=true&w=majority

# Port du serveur Express
PORT=5000

# URL du frontend autorisée (CORS)
FRONTEND_URL=http://localhost:5173

# Origines CORS supplémentaires (séparées par des virgules) — ex. previews Vercel
# EXTRA_ORIGINS=https://mon-app-xyz.vercel.app

# Environnement : development | production
NODE_ENV=development

# URL du microservice ML Python (Vente + Location)
ML_SERVICE_URL=http://127.0.0.1:8000

# URL du microservice Geo Python (POIs, distances, cache H3)
GEO_SERVICE_URL=http://127.0.0.1:8001

# ─────────────────────────────────────────────────────────────
# PRODUCTION (Render) — valeurs à définir dans le Dashboard :
#   MONGO_URL        → URI Atlas (obligatoire)
#   SESSION_SECRET   → généré auto par render.yaml
#   FRONTEND_URL     → https://mon-app.vercel.app
#   ML_SERVICE_URL   → https://due-diligence-ml.onrender.com
#   GEO_SERVICE_URL  → https://due-diligence-geo.onrender.com
#   NODE_ENV         → production
# (PORT est injecté automatiquement par Render)
# ─────────────────────────────────────────────────────────────

