# ── GeoService FastAPI (Render) ──────────────────────────────────────

# MongoDB Atlas (cache géospatial H3) — même cluster que le Backend
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/dueDillegenceDB?retryWrites=true&w=majority

# Token Mapbox (optionnel : sans token, fallback sur les distances OSM)
MAPBOX_ACCESS_TOKEN=pk.xxxxx
